NODE_ENV=development

# Firebase Admin (SERVER ONLY - JANGAN beri prefix VITE_)
# Ambil service account JSON dari Firebase Console > Project settings > Service accounts.
# Encode JSON tersebut ke base64 lalu isi nilai di bawah.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_STORAGE_BUCKET=video-belajar-787c8.firebasestorage.app

# URL frontend. Untuk single Vercel project, gunakan URL project yang sama.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# JWT aplikasi
JWT_SECRET=ganti-dengan-random-string-panjang
JWT_EXPIRES_IN=7d

# Optional: admin awal. Akun dibuat saat server lokal dijalankan.
ADMIN_EMAIL=admin@videobelajar.com
ADMIN_PASSWORD=ganti-password-admin
SUPER_ADMIN_EMAIL=superadmin@videobelajar.com
SUPER_ADMIN_PASSWORD=ganti-password-superadmin

# Optional SMTP untuk verifikasi/reset password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="VideoBelajar <no-reply@example.com>"
