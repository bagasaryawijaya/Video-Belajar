PORT=5000
NODE_ENV=development

# Existing MySQL (course/blog/payment modules)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=video_belajar

# Firebase Admin
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_SERVICE_ACCOUNT_BASE64=

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional default admin accounts
ADMIN_EMAIL=admin@videobelajar.com
ADMIN_PASSWORD=change-this-admin-password
SUPER_ADMIN_EMAIL=superadmin@videobelajar.com
SUPER_ADMIN_PASSWORD=change-this-superadmin-password

# SMTP (Gmail App Password / SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bagasaryawijaya27@gmail.com
SMTP_PASSWORD=PASTE_16_CHAR_GOOGLE_APP_PASSWORD_WITHOUT_SPACES
MAIL_FROM=

# Frontend + CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
