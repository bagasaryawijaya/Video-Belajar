{
  "name": "video-belajar-fullstack",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "predev": "node scripts/ensure-deps.cjs",
    "dev": "concurrently \"npm --prefix frontend run dev\" \"npm --prefix backend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend ci --include=dev && npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.9",
    "sequelize": "^6.37.8"
  }
}
